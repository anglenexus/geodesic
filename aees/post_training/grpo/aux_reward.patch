         return
 
     precomputed_reverse_kls = rollout_data.get("opd_reverse_kl")
+    if getattr(args, "opd_baseline", "student_logp") == "exact":
+        apply_opd_exact_to_advantages(args, rollout_data, advantages, student_log_probs)
+        return
     if precomputed_reverse_kls is not None:
         if len(advantages) != len(precomputed_reverse_kls):
             raise ValueError(
@@ -92,3 +95,28 @@ def apply_opd_kl_to_advantages(
 
     # Store reverse KL for logging.
     rollout_data["opd_reverse_kl"] = reverse_kls
+
+
+def apply_opd_exact_to_advantages(
+    args: Namespace,
+    rollout_data: RolloutBatch,
+    advantages: list[torch.Tensor],
+    student_log_probs: list[torch.Tensor],
+) -> None:
+    """--opd-baseline exact: advantages += opd_kl_coef * A^Q per response token, A^Q = Q(s, x) − Σ_a π(a|s)·Q(s, a)
+    from the teacher's raw logits and the policy's distribution (megatron_utils/aux_q.py, rollout_data["aux_q"]).
+    No entropy term. The sampled-token reverse KL (student_logp − teacher_logp) is still stored for logging."""
+    aux_q = rollout_data.get("aux_q")
+    teacher_log_probs = rollout_data.get("teacher_log_probs")
+    if aux_q is None or teacher_log_probs is None:
+        raise ValueError("--opd-baseline exact needs aux_q and teacher_log_probs (teacher pass, then policy pass).")
+    if not (len(advantages) == len(aux_q) == len(student_log_probs) == len(teacher_log_probs)):
+        raise ValueError(f"OPD length mismatch: advantages={len(advantages)}, aux_q={len(aux_q)}.")
+    reverse_kls = []
+    for i, adv in enumerate(advantages):
+        a = aux_q[i].detach().to(device=adv.device, dtype=adv.dtype)
+        if a.shape != adv.shape:
+            raise ValueError(f"OPD shape mismatch at sample {i}: advantages={tuple(adv.shape)}, aux_q={tuple(a.shape)}.")
+        advantages[i] = adv + args.opd_kl_coef * a
+        reverse_kls.append(student_log_probs[i].detach() - teacher_log_probs[i].detach().to(adv.device))
+    rollout_data["opd_reverse_kl"] = reverse_kls
