diff --git a/miles/backends/megatron_utils/aux_q.py b/miles/backends/megatron_utils/aux_q.py
new file mode 100644
index 0000000000..49486e6eef
--- /dev/null
+++ b/miles/backends/megatron_utils/aux_q.py
@@ -0,0 +1,121 @@
+"""--opd-baseline exact (aees auxiliary reward): the teacher's per-token advantage against the policy,
+
+    A^Q(s, x) = Q(s, x) − Σ_a π(a|s)·Q(s, a)
+
+Q = the teacher's raw logits (the Q-function: no softmax), π = softmax(policy logits / rollout temperature), at the
+same position; Σ_a π·Q = V(s) under π, so the baseline is exact. The two logit vectors come from different passes over
+the same micro-batches in the same order (actor.py: the teacher pass, then the policy's old-log-prob pass). Full
+logits are too large to keep, so the teacher pass saves each micro-batch's final hidden states (the output layer's
+input) and the policy pass recomputes Q = W·h, W the weight the output layer is called with (Megatron passes the
+embedding there when the model ties them). The output layer is shared: LoRA doesn't adapt it and the teacher is the
+base with an adapter merged into the adapted projections. Tensor, context and pipeline parallel size 1 only.
+"""
+import os
+import shutil
+from contextlib import contextmanager
+from pathlib import Path
+
+import torch
+
+
+def aq_rows(z_pi: torch.Tensor, h_q: torch.Tensor, weight: torch.Tensor, targets: torch.Tensor,
+            temperature: float = 1.0, vocab: int | None = None, chunk: int = 1024) -> torch.Tensor:
+    """A^Q for R rows: z_pi (R, V) policy logits, h_q (R, H) teacher hidden states, weight (V, H), targets (R,).
+    fp32, in chunks of rows (one chunk's two (chunk, V) blocks at a time)."""
+    out = []
+    for i in range(0, targets.shape[0], chunk):
+        zp, zq = z_pi[i:i + chunk].float(), (h_q[i:i + chunk] @ weight.T).float()
+        if vocab is not None:
+            zp, zq = zp[:, :vocab], zq[:, :vocab]
+        pi = torch.softmax(zp / temperature, dim=-1)
+        out.append(zq.gather(-1, targets[i:i + chunk, None].long()).squeeze(-1) - (pi * zq).sum(-1))
+    return torch.cat(out) if out else z_pi.new_zeros(0, dtype=torch.float32)
+
+
+def per_sample(logits, aux_hidden, aux_weight, *, args, unconcat_tokens, total_lengths, response_lengths,
+               max_seq_lens=None) -> list[torch.Tensor]:
+    """A^Q on each sample's response rows, sliced exactly as the log-probs are (get_responses on both tensors)."""
+    from miles.backends.training_utils.loss.hub.logit_processors import get_responses
+
+    kw = dict(args=args, unconcat_tokens=unconcat_tokens, total_lengths=total_lengths,
+              response_lengths=response_lengths, max_seq_lens=max_seq_lens)
+    out = []
+    for (z_pi, x), (h_q, x_h) in zip(get_responses(logits, **kw), get_responses(aux_hidden, **kw), strict=True):
+        assert torch.equal(x, x_h) and z_pi.shape[0] == h_q.shape[0]
+        out.append(aq_rows(z_pi, h_q, aux_weight, x, args.rollout_temperature, getattr(args, "vocab_size", None)))
+    return out
+
+
+def _output_layer(model) -> torch.nn.Module:
+    found = [m for name, m in model[0].named_modules() if name.split(".")[-1] == "output_layer"]
+    assert len(found) == 1, f"expected one output_layer, found {len(found)}"
+    return found[0]
+
+
+class AuxQ:
+    """One forward_only pass: 'teacher' saves hidden states per micro-batch, 'policy' loads them in the same order."""
+
+    def __init__(self, model, mode: str, directory: Path):
+        self.mode, self.dir, self.k, self.captured = mode, directory, 0, []
+        self.layer = _output_layer(model)
+        self.hook = self.layer.register_forward_pre_hook(self._capture, with_kwargs=True)
+
+    def _capture(self, module, inputs, kwargs):
+        weight = kwargs.get("weight")
+        self.captured.append((inputs[0], module.weight if weight is None else weight))
+
+    def after_forward(self, output_tensor: torch.Tensor) -> dict:
+        """Called after each micro-batch's forward; returns extra callback kwargs (policy pass) or {}."""
+        assert self.captured, "the output layer didn't run"
+        h, weight = self.captured[0]                         # the main head's call (MTP heads would come after)
+        h = h.transpose(0, 1)                                # [S, 1, H] -> [1, S, H]
+        self.captured.clear()
+        assert h.shape[:2] == output_tensor.shape[:2], f"{h.shape} vs {output_tensor.shape}"
+        path, self.k = self.dir / f"{self.k}.pt", self.k + 1
+        if self.mode == "teacher":
+            torch.save(h.detach().to("cpu"), path)
+            return {}
+        h_q = torch.load(path).to(output_tensor.device)
+        assert h_q.shape == h.shape, f"micro-batch {self.k - 1}: teacher {tuple(h_q.shape)} vs policy {tuple(h.shape)}"
+        assert weight is not None, "the output layer has no weight"
+        return {"aux_hidden": h_q, "aux_weight": weight}
+
+    def end(self) -> None:
+        self.hook.remove()
+        if self.mode == "teacher":
+            (self.dir / "count").write_text(str(self.k))
+        else:
+            n = int((self.dir / "count").read_text())
+            assert self.k == n, f"policy pass ran {self.k} micro-batches, teacher pass {n}"
+            shutil.rmtree(self.dir, ignore_errors=True)
+
+
+def begin(args, model, store_prefix: str) -> AuxQ | None:
+    if getattr(args, "opd_baseline", None) != "exact" or store_prefix not in ("teacher_", ""):
+        return None
+    directory = Path(os.environ.get("MILES_AUX_Q_DIR", "/tmp/miles_aux_q"))
+    if store_prefix == "teacher_":
+        shutil.rmtree(directory, ignore_errors=True)
+        directory.mkdir(parents=True)
+        return AuxQ(model, "teacher", directory)
+    assert (directory / "count").exists(), "--opd-baseline exact: the policy pass needs the teacher pass first"
+    return AuxQ(model, "policy", directory)
+
+
+@contextmanager
+def teacher_lora(model, adapter_path: str):
+    """--opd-teacher-lora-path: the policy's adapter tensors are saved (on the GPU, ~0.6 GB at rank 64 on 27B), the
+    teacher's HF/PEFT adapter is loaded into the same modules, and the policy's tensors are copied back afterwards,
+    whatever happens in between."""
+    from miles.backends.megatron_utils.lora.native.hf_adapter import load_lora_adapter_hf
+    from miles.backends.megatron_utils.lora.utils import _adapter_shard_params
+
+    params = _adapter_shard_params(model)
+    saved = {name: p.detach().clone() for name, p in params.items()}
+    try:
+        load_lora_adapter_hf(model, adapter_path)
+        yield
+    finally:
+        with torch.no_grad():
+            for name, p in params.items():
+                p.copy_(saved[name])
