diff --git a/tests/fast/rollout/test_resubmit_dropped_groups.py b/tests/fast/rollout/test_resubmit_dropped_groups.py
new file mode 100644
index 0000000000..9813a997ca
--- /dev/null
+++ b/tests/fast/rollout/test_resubmit_dropped_groups.py
@@ -0,0 +1,85 @@
+"""--resubmit-dropped-groups: a group the dynamic filter drops is run again with the same prompt, so every prompt
+of the batch is in the rollout once; new prompts are never drawn to replace it."""
+import asyncio
+import types
+
+import pytest
+
+from tests.fast.ray.rollout.conftest import make_args, make_sample
+from miles.rollout.inference_rollout import inference_rollout_train as train
+from miles.utils.types import Sample
+
+N = 2  # samples per prompt
+
+
+def _args(**kw):
+    base = dict(rollout_batch_size=3, over_sampling_batch_size=3, n_samples_per_prompt=N, partial_rollout=False,
+                dynamic_sampling_filter_path="miles.rollout.filter_hub.dynamic_sampling_filters.check_no_aborted",
+                rollout_sample_filter_path=None, rollout_all_samples_process_path=None, reward_key=None,
+                rollout_global_dataset=True, enable_sample_ownership_checker=False, resubmit_dropped_groups=3)
+    base.update(kw)
+    return make_args(**base)
+
+
+async def _no_op(*a, **k):
+    return None
+
+
+async def _empty(*a, **k):
+    return []
+
+
+def _run(monkeypatch, args, aborts):
+    """aborts: prompt index -> number of first attempts that come back with an aborted sample."""
+    state = types.SimpleNamespace(args=args, sampling_params={}, reset=lambda: None)
+    attempts, drawn = {}, []
+
+    async def generate_and_rm_group(_state, group, sampling_params, evaluation, sample_done_callback=None):
+        i = group[0].index
+        attempts[i] = attempts.get(i, 0) + 1
+        await asyncio.sleep(0.001 * i)
+        bad = attempts[i] <= aborts.get(i, 0)
+        for k, s in enumerate(group):
+            s.status = Sample.Status.ABORTED if bad and k == 0 else Sample.Status.COMPLETED
+            s.reward = float(attempts[i])
+        return group
+
+    def data_source(count):
+        start = len(drawn)
+        groups = [[make_sample(index=start + j, reward=0.0, status=Sample.Status.PENDING) for _ in range(N)]
+                  for j in range(count)]
+        drawn.extend(range(start, start + count))
+        return groups
+
+    monkeypatch.setattr(train, "generate_and_rm_group", generate_and_rm_group)
+    monkeypatch.setattr(train.dumper_utils, "configure_sglang", _no_op)
+    monkeypatch.setattr(train, "abort", _empty)
+    monkeypatch.setattr(train, "recompute_samples_rollout_logprobs_via_prefill", _no_op)
+    out = asyncio.run(train.generate_rollout_async(state, 0, data_source))[0]
+    return out.samples, attempts, drawn
+
+
+def test_one_dropped_group_reruns_its_own_prompt(monkeypatch):
+    data, attempts, drawn = _run(monkeypatch, _args(), {1: 1})
+    assert drawn == [0, 1, 2]                                   # no new prompts drawn
+    assert [g[0].index for g in data] == [0, 1, 2]              # every prompt once, in order
+    assert attempts == {0: 1, 1: 2, 2: 1}
+    assert all(s.status == Sample.Status.COMPLETED for g in data for s in g)
+    assert [s.reward for s in data[1]] == [2.0] * N             # the clean second attempt
+
+
+def test_several_dropped_groups_each_rerun_their_own_prompt(monkeypatch):
+    data, attempts, drawn = _run(monkeypatch, _args(), {0: 2, 2: 1})
+    assert drawn == [0, 1, 2] and [g[0].index for g in data] == [0, 1, 2]
+    assert attempts == {0: 3, 1: 1, 2: 2}
+
+
+def test_a_prompt_dropped_too_often_stops_the_rollout(monkeypatch):
+    with pytest.raises(RuntimeError, match="group 1 dropped 2 times"):
+        _run(monkeypatch, _args(resubmit_dropped_groups=1), {1: 5})
+
+
+def test_off_keeps_the_refill_from_the_data_source(monkeypatch):
+    data, attempts, drawn = _run(monkeypatch, _args(resubmit_dropped_groups=0), {1: 1})
+    assert drawn == [0, 1, 2, 3, 4, 5]                          # a whole new batch to replace one group
+    assert 1 not in [g[0].index for g in data]
