+    async def _starts_command(self, keystrokes: str, session: TmuxSession) -> bool:
+        """Whether these keystrokes start a new shell command: they press Enter while the shell is at its
+        prompt. Keys typed into a running program (an editor, a REPL, a script reading stdin) don't start one."""
+        if self._command_timeout_sec is None or not session.runs_command(keystrokes):
+            return False
+        try:
+            job = await session.foreground_job()
+            if job is not None and self._shell_job is None:  # before the first command the shell is at its prompt
+                self._shell_job = job
+            return job is not None and job == self._shell_job
+        except Exception as e:  # an unreadable terminal must not end the trial
+            self.logger.debug(f"Command time limit check failed: {e}")
+            return False
+
+    def _watch_command(self, keystrokes: str, session: TmuxSession) -> None:
+        self._command_seq += 1
+        task = asyncio.create_task(
+            self._interrupt_after_limit(self._command_seq, keystrokes, session)
+        )
+        self._command_watchdogs.add(task)
+        task.add_done_callback(self._command_watchdogs.discard)
+
+    async def _interrupt_after_limit(
+        self, seq: int, keystrokes: str, session: TmuxSession
+    ) -> None:
+        """After the limit, send Ctrl-C if this command is still in the foreground, and kill its process group if it
+        is still there 2 s later. A newer command means the shell was back at its prompt, so this one had
+        finished; the check is repeated after each wait, before anything is sent."""
+        await asyncio.sleep(self._command_timeout_sec)
+        try:
+            job = await session.foreground_job()
+            if seq != self._command_seq or job is None or job == self._shell_job:  # superseded, unreadable, finished
+                return
+            await session.send_keys("C-c", block=False, min_timeout_sec=2.0)
+            how = "interrupted with Ctrl-C"
+            if seq == self._command_seq and await session.foreground_job() == job:
+                await session.environment.exec(
+                    command=f"kill -KILL -- -{job}", user=session._user
+                )
+                how = "killed (it kept running after Ctrl-C)"
+            self._command_notes.append(
+                f"Command timed out after {self._command_timeout_sec:g} seconds and was {how}: "
+                f"{keystrokes.strip()[:200]}"
+            )
+        except Exception as e:  # the environment may be gone when the trial ended meanwhile
+            self.logger.debug(f"Command time limit check failed: {e}")
+
+    def _take_command_notes(self) -> str:
+        notes, self._command_notes = self._command_notes, []
+        return "".join(note + "\n" for note in notes)
