     def _is_executing_command(self, key: str) -> bool:
         return self._is_enter_key(key) or self._ends_with_newline(key)
 
+    def runs_command(self, keys: str) -> bool:
+        """Whether sending *keys* presses Enter, i.e. runs what was typed."""
+        return bool(keys) and self._is_executing_command(keys)
+
+    # The foreground process group of the terminal the agent types into. Terminus-2 records the session with
+    # `asciinema rec`, which runs the agent's shell in a terminal of its own; when the pane's foreground job has a
+    # child that leads its own session (a recorder), follow it into that terminal. /proc only: task images may lack
+    # ps. Fields after "comm) ": 2 ppid, 4 session, 6 tpgid.
+    _FOREGROUND_JOB_SH = (
+        "st() {{ sed 's/.*) //' /proc/$1/stat 2>/dev/null; }}; "
+        "p=$(tmux display-message -p -t {session} '#{{pane_pid}}') || exit 1; "
+        "for _ in 1 2 3 4; do set -- $(st $p); tp=$6; [ -n \"$tp\" ] || exit 1; c=; "
+        "for f in /proc/[0-9]*; do q=${{f#/proc/}}; set -- $(st $q); "
+        "[ \"$2\" = \"$tp\" ] && [ \"$4\" = \"$q\" ] && {{ c=$q; break; }}; done; "
+        "[ -n \"$c\" ] || break; p=$c; done; echo $tp"
+    )
+
+    async def foreground_job(self) -> int | None:
+        """The foreground process group of the agent's terminal (None when it can't be read). It equals the shell's
+        own group while the shell waits at its prompt; Terminus2 records that value before the first command."""
+        result = await self.environment.exec(
+            command=self._FOREGROUND_JOB_SH.format(session=self._session_name),
+            user=self._user,
+        )
+        out = (result.stdout or "").strip()
+        return int(out) if result.return_code == 0 and out.isdigit() else None
+
