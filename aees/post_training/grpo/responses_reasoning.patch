diff --git a/tests/unit/llms/test_responses_reasoning.py b/tests/unit/llms/test_responses_reasoning.py
new file mode 100644
index 00000000..606eb00a
--- /dev/null
+++ b/tests/unit/llms/test_responses_reasoning.py
@@ -0,0 +1,239 @@
+"""Responses API: reasoning summaries, stateless calls, cached-token pricing, and the max_seq_len context stop."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from harbor.llms.base import LLMResponse, MaxSeqLenExceededError, UsageInfo
+from harbor.llms.chat import Chat
+from harbor.llms.lite_llm import LiteLLM
+
+PRICES = {
+    "max_input_tokens": 65536,
+    "max_output_tokens": 16384,
+    "input_cost_per_token": 2e-07,
+    "output_cost_per_token": 1.2e-06,
+    "cache_read_input_token_cost": 2e-08,
+}
+
+
+def _response(summaries=("**Plan**\n\nInspect the files.",), encrypted="gAAAA-enc", reasoning_tokens=120,
+              input_tokens=1000, cached=600, output_tokens=300):
+    items = []
+    if summaries is not None:
+        items.append(SimpleNamespace(type="reasoning", encrypted_content=encrypted,
+                                     summary=[SimpleNamespace(type="summary_text", text=t) for t in summaries]))
+    items.append(SimpleNamespace(type="message", content=[SimpleNamespace(type="output_text", text='{"analysis": "a"}')]))
+    usage = SimpleNamespace(input_tokens=input_tokens, output_tokens=output_tokens,
+                            input_tokens_details=SimpleNamespace(cached_tokens=cached),
+                            output_tokens_details=SimpleNamespace(reasoning_tokens=reasoning_tokens))
+    return SimpleNamespace(id="resp_1", model="gpt-5.6-luna", output=items, usage=usage, status="completed",
+                           _hidden_params={})
+
+
+def _llm(**llm_kwargs):
+    return LiteLLM(model_name="openai/fake-luna-test", use_responses_api=True, reasoning_effort="high",
+                   model_info=PRICES, **llm_kwargs)
+
+
+@pytest.fixture
+def captured(monkeypatch):
+    calls = []
+
+    async def fake_aresponses(**kwargs):
+        calls.append(kwargs)
+        return calls_response[0]
+
+    calls_response = [_response()]
+    monkeypatch.setattr("litellm.aresponses", fake_aresponses)
+    monkeypatch.setattr("litellm.completion_cost", lambda **_: 0.0)
+    return SimpleNamespace(calls=calls, set_response=lambda r: calls_response.__setitem__(0, r))
+
+
+@pytest.mark.asyncio
+async def test_summary_requested_and_stored(captured):
+    r = await _llm(reasoning_summary="detailed", responses_stateless=True).call(prompt="go", message_history=[])
+    sent = captured.calls[0]
+    assert sent["reasoning"] == {"effort": "high", "summary": "detailed"}
+    assert sent["store"] is False and "include" not in sent  # no encrypted reasoning: nobody but OpenAI can read it
+    assert "reasoning_summary" not in sent and "responses_stateless" not in sent  # not leaked to the API
+    assert r.reasoning_content == "**Plan**\n\nInspect the files."
+    assert r.extra == {"reasoning_tokens": 120, "reasoning_content_kind": "provider summary (detailed)",
+                       "reasoning_summary_parts": 1}
+
+
+@pytest.mark.asyncio
+async def test_multiple_summary_parts_joined(captured):
+    captured.set_response(_response(summaries=("A", "B")))
+    r = await _llm(reasoning_summary="detailed", responses_stateless=True).call(prompt="go", message_history=[])
+    assert r.reasoning_content == "A\n\nB" and r.extra["reasoning_summary_parts"] == 2
+
+
+@pytest.mark.asyncio
+async def test_missing_summary_still_records_reasoning_tokens(captured):
+    captured.set_response(_response(summaries=()))
+    r = await _llm(reasoning_summary="detailed", responses_stateless=True).call(prompt="go", message_history=[])
+    assert r.reasoning_content is None
+    assert r.extra["reasoning_tokens"] == 120 and r.extra["reasoning_summary_parts"] == 0
+
+
+@pytest.mark.asyncio
+async def test_stateless_sends_full_history_and_no_chain(captured):
+    llm = _llm(reasoning_summary="detailed", responses_stateless=True)
+    hist = [{"role": "user", "content": "q1"}, {"role": "assistant", "content": "a1"}]
+    r = await llm.call(prompt="q2", message_history=hist, previous_response_id="resp_0")
+    sent = captured.calls[0]
+    assert "previous_response_id" not in sent
+    assert sent["input"] == hist + [{"role": "user", "content": "q2"}]
+    assert r.response_id is None  # so Chat never starts a chain
+
+
+@pytest.mark.asyncio
+async def test_max_tokens_maps_to_max_output_tokens(captured):
+    await _llm(responses_stateless=True).call(prompt="go", message_history=[], max_tokens=16384)
+    sent = captured.calls[0]
+    assert sent["max_output_tokens"] == 16384 and "max_tokens" not in sent
+
+
+@pytest.mark.asyncio
+async def test_cached_tokens_and_cost(captured):
+    r = await _llm(responses_stateless=True).call(prompt="go", message_history=[])
+    assert r.usage.cache_tokens == 600
+    assert r.usage.cost_usd == pytest.approx(400 * 2e-07 + 600 * 2e-08 + 300 * 1.2e-06)
+
+
+@pytest.mark.asyncio
+async def test_default_behaviour_unchanged(captured):
+    """Without the new options: no summary, no store/include, chain id returned, no extra."""
+    captured.set_response(_response(summaries=None))  # the API sends no reasoning item unless asked
+    r = await _llm().call(prompt="go", message_history=[])
+    sent = captured.calls[0]
+    assert sent["reasoning"] == {"effort": "high"}
+    assert "store" not in sent and "include" not in sent
+    assert r.response_id == "resp_1" and r.extra is None
+
+
+class _FixedLLM:
+    def __init__(self, prompt_tokens, completion_tokens):
+        self.usage = UsageInfo(prompt_tokens=prompt_tokens, completion_tokens=completion_tokens, cache_tokens=0,
+                               cost_usd=0.01)
+
+    async def call(self, **_):
+        return LLMResponse(content="x", usage=self.usage)
+
+
+@pytest.mark.asyncio
+async def test_chat_max_seq_len_stops_over_limit():
+    with pytest.raises(MaxSeqLenExceededError):
+        await Chat(_FixedLLM(60000, 6000), max_seq_len=65536).chat("p")
+    chat = Chat(_FixedLLM(60000, 5000), max_seq_len=65536)
+    await chat.chat("p")
+    assert len(chat.messages) == 2
+
+
+# ---- carrying reasoning back (responses_carry_reasoning) ----
+
+CARRY = dict(reasoning_summary="detailed", responses_stateless=True, responses_carry_reasoning=True)
+
+
+def _response_with_id(**kw):
+    r = _response(**kw)
+    r.output[0].id = "rs_1"
+    r.output[0].model_dump = lambda exclude_none=True: {"id": "rs_1", "type": "reasoning", "encrypted_content": "gAAAA-enc",
+                                                        "summary": [{"type": "summary_text", "text": "x"}]}
+    return r
+
+
+@pytest.mark.asyncio
+async def test_carry_requests_encrypted_and_returns_items(captured):
+    captured.set_response(_response_with_id())
+    r = await _llm(**CARRY).call(prompt="go", message_history=[])
+    assert captured.calls[0]["include"] == ["reasoning.encrypted_content"]
+    assert r.reasoning_items == [{"type": "reasoning", "id": "rs_1", "summary": [], "encrypted_content": "gAAAA-enc"}]
+    assert r.extra["reasoning_encrypted"] == ["gAAAA-enc"]  # stored with the step
+    assert r.reasoning_content == "**Plan**\n\nInspect the files."
+
+
+@pytest.mark.asyncio
+async def test_carry_sends_reasoning_back_before_each_reply(captured):
+    """Through Chat: the 2nd call's input has turn 1's reasoning item right before turn 1's reply."""
+    captured.set_response(_response_with_id())
+    chat = Chat(_llm(**CARRY))
+    await chat.chat("step 1")
+    await chat.chat("step 2")
+    second = captured.calls[1]
+    assert "previous_response_id" not in second
+    assert second["input"] == [
+        {"role": "user", "content": "step 1"},
+        {"type": "reasoning", "id": "rs_1", "summary": [], "encrypted_content": "gAAAA-enc"},
+        {"role": "assistant", "content": '{"analysis": "a"}'},
+        {"role": "user", "content": "step 2"},
+    ]
+
+
+@pytest.mark.asyncio
+async def test_no_carry_sends_no_reasoning_back(captured):
+    chat = Chat(_llm(reasoning_summary="detailed", responses_stateless=True))
+    await chat.chat("step 1")
+    await chat.chat("step 2")
+    assert "include" not in captured.calls[1]
+    assert all("type" not in item for item in captured.calls[1]["input"])
+    assert "reasoning_items" not in chat.messages[1]
+
+
+@pytest.mark.asyncio
+async def test_terminus_context_limit_stop_is_marked(tmp_path):
+    """A max_seq_len stop ends the agent normally (verifier grades), is marked in metadata, and all_messages
+    leaves out the encrypted reasoning items (the trajectory steps store them)."""
+    from harbor.agents.terminus_2.terminus_2 import Terminus2
+    from harbor.models.agent.context import AgentContext
+
+    agent = Terminus2(logs_dir=tmp_path, model_name="openai/fake-luna-test", model_info=PRICES, use_responses_api=True,
+                      stop_at_context_limit=True, max_seq_len=65536, store_all_messages=True, enable_summarize=False)
+
+    class _Session:
+        async def get_incremental_output(self):
+            return "$ "
+
+    async def no_skills(_env):
+        return ""
+
+    async def loop(initial_prompt, chat, original_instruction):
+        chat.messages.extend([{"role": "user", "content": "p"},
+                              {"role": "assistant", "content": "a", "reasoning_items": [{"type": "reasoning"}]}])
+        raise MaxSeqLenExceededError("Sequence length (70000) exceeded limit (65536)")
+
+    agent._session = _Session()
+    agent._build_skills_section = no_skills
+    agent._run_agent_loop = loop
+    agent._dump_trajectory = lambda: None
+    ctx = AgentContext()
+    await agent.run("do it", environment=None, context=ctx)  # no exception: the verifier runs next
+    assert ctx.metadata["stopped_at_context_limit"] is True
+    assert "70000" in ctx.metadata["context_limit_detail"]
+    assert ctx.metadata["all_messages"][1] == {"role": "assistant", "content": "a"}
+
+
+@pytest.mark.asyncio
+async def test_terminus_without_stop_flag_raises(tmp_path):
+    from harbor.agents.terminus_2.terminus_2 import Terminus2
+    from harbor.models.agent.context import AgentContext
+
+    agent = Terminus2(logs_dir=tmp_path, model_name="openai/fake-luna-test", model_info=PRICES, max_seq_len=65536)
+
+    class _Session:
+        async def get_incremental_output(self):
+            return "$ "
+
+    async def no_skills(_env):
+        return ""
+
+    async def loop(**_):
+        raise MaxSeqLenExceededError("over")
+
+    agent._session = _Session()
+    agent._build_skills_section = no_skills
+    agent._run_agent_loop = loop
+    agent._dump_trajectory = lambda: None
+    with pytest.raises(MaxSeqLenExceededError):
+        await agent.run("do it", environment=None, context=AgentContext())
