# local environment
.venv/
*.egg-info/
.pytest_cache/
__pycache__/

# runtime state: the ledger, live schedule copies, logs and the STOP switch stay local
state/ledger*.sqlite*
state/*.log
state/*.tmp
state/*.harbor.log
state/scheduler.stdout
state/STOP
state/schedule_overnight.json
state/schedule_ec2.json
state/overnight_checks.md

# real trial dirs used as local fixtures (benchmark content + local paths); rebuild with
# tests/fixtures/make_fixtures.py
tests/fixtures/trials/
state/tasks_i*.txt
state/ec2_checks.md
state/ec2_report_i*.md
state/schedule_candidates.json
state/round2_launcher.*
state/round2_checks.md
state/scheduler_candidates.stdout
state/status_server.log
state/browse_server.log
state/remotes.json
state/remote/
state/remote_sync.log
state/ec2_checks_local.md
# per-run plan copies, check logs and scheduler output (the templates live in ec2/)
state/schedule_*.json
state/*_checks.md
state/scheduler_*.stdout
